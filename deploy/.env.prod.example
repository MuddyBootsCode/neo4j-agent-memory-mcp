# deploy/.env.prod.example
# Copy to deploy/.env and fill in values before deploying

# Neo4j
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
# Use 7688 to avoid conflict with existing hume-neo4j on 7687
NEO4J_URI=bolt://localhost:7688
NEO4J_DATABASE=neo4j

# BAML entity extraction
NAM_EXTRACTION__BAML_ENABLED=true
NAM_EXTRACTION__BAML_CLIENT=Bedrock

# AWS (Bedrock LLM + embeddings)
# In production on EC2/ECS, use IAM role instead of profile
AWS_REGION=us-east-1
# AWS_PROFILE=graphable-aws  # local dev only; prod uses IAM role
NAM_EMBEDDING_PROVIDER=bedrock
NAM_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
NAM_EMBEDDING_DIMENSIONS=1024

# Verticals & routing

# MCP transport
MCP_TRANSPORT=sse
MCP_HOST=0.0.0.0
# Use 8082 to avoid conflict with hume-api on 8080
MCP_PORT=8082

# Docker management (true when Neo4j is on same host)
NEO4J_DOCKER_AUTO=false

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
