# Neo4j connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphmemory
NEO4J_DATABASE=neo4j

# Local Anthropic-direct mode (docker compose up -d): no Bedrock/AWS.
# Extraction uses the Anthropic API; embeddings run locally
# (sentence-transformers). See README "Local mode".
# If you run the server on the host with these vars exported, comment out
# the NAM_EMBEDDING_* lines below: an explicit NAM_EMBEDDING_PROVIDER wins
# over the key-derived local default and sends embeddings back to Bedrock.
# ANTHROPIC_API_KEY=sk-ant-...
# NAM_ANTHROPIC_MODEL=claude-opus-5
# NAM_HTTP_TOKEN=local-dev-token

# AWS (Bedrock LLM extraction + embeddings)
AWS_PROFILE=graphable-aws
AWS_REGION=us-east-1
NAM_EMBEDDING_PROVIDER=bedrock
NAM_EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
NAM_EMBEDDING_DIMENSIONS=1024

# Temporal fact management
NAM_TEMPORAL_EXTRACTION=true
NAM_CONTRADICTION_DETECTION=true

# MCP server transport (for network/cloud deployment)
# MCP_TRANSPORT=sse
# MCP_HOST=0.0.0.0
# MCP_PORT=8080

# Logging
# LOG_LEVEL=INFO
# LOG_FORMAT=json
